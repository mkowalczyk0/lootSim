{
  "name": "lootsim",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "markers": "! git grep -nE '^(<{7}|={7}|>{7}) ' -- ':!*.lock' || (echo 'conflict markers committed' && exit 1)",
    "smoke": "esbuild tools/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=error && node node_modules/.cache/smoke.mjs",
    "vocab": "esbuild tools/vocab.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/vocab.mjs --log-level=error && node node_modules/.cache/vocab.mjs",
    "prog": "esbuild tools/progression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/progression.mjs --log-level=error && node node_modules/.cache/progression.mjs",
    "classes": "esbuild tools/classes.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/classes.mjs --log-level=error && node node_modules/.cache/classes.mjs",
    "roster": "esbuild tools/roster.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/roster.mjs --log-level=error && node node_modules/.cache/roster.mjs",
    "rules": "esbuild tools/rules.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rules.mjs --log-level=error && node node_modules/.cache/rules.mjs",
    "named": "esbuild tools/named.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/named.mjs --log-level=error && node node_modules/.cache/named.mjs",
    "forge": "esbuild tools/forge.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/forge.mjs --log-level=error && node node_modules/.cache/forge.mjs",
    "rewards": "esbuild tools/rewards.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rewards.mjs --log-level=error && node node_modules/.cache/rewards.mjs",
    "itemart": "esbuild tools/itemart.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/itemart.mjs --log-level=error && node node_modules/.cache/itemart.mjs",
    "world": "esbuild tools/world.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/world.mjs --log-level=error && node node_modules/.cache/world.mjs",
    "previews": "esbuild tools/previews.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/previews.mjs --log-level=error && node node_modules/.cache/previews.mjs",
    "relics": "esbuild tools/relics.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/relics.mjs --log-level=error && node node_modules/.cache/relics.mjs",
    "legends": "esbuild tools/legends.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/legends.mjs --log-level=error && node node_modules/.cache/legends.mjs",
    "universal": "esbuild tools/universal.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/universal.mjs --log-level=error && node node_modules/.cache/universal.mjs",
    "test": "npm run markers && npm run check && npm run vocab && npm run prog && npm run classes && npm run roster && npm run rules && npm run universal && npm run named && npm run legends && npm run forge && npm run previews && npm run world && npm run itemart && npm run relics && npm run rewards && npm run deadpaths && npm run smoke",
    "arena": "esbuild tools/arena.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/arena.mjs --log-level=error && node node_modules/.cache/arena.mjs",
    "art": "esbuild tools/artsheet.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/artsheet.mjs --log-level=error && node node_modules/.cache/artsheet.mjs",
    "relay": "esbuild tools/relay.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/relay.mjs --log-level=error && node node_modules/.cache/relay.mjs",
    "tileset": "esbuild tools/tileset.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tileset.mjs --log-level=error && node node_modules/.cache/tileset.mjs",
    "builds": "esbuild tools/builds.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/builds.mjs --log-level=error && node node_modules/.cache/builds.mjs",
    "deadpaths": "esbuild tools/deadpaths.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deadpaths.mjs --log-level=error && node node_modules/.cache/deadpaths.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "^0.24.0"
  }
}
